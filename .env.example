# Requerida — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional — respaldo gratuito si Gemini falla o se queda sin cuota
# https://console.groq.com/keys
GROQ_API_KEY=

# Opcionales — para cambiar de modelos sin tocar código
# GEMINI_MODELS=gemini-flash-lite-latest,gemini-flash-latest   # se prueban en orden
# GROQ_MODEL=openai/gpt-oss-120b

# Opcional — imágenes de mejor calidad (sin ella se usa solo Openverse)
# https://www.pexels.com/api/
PEXELS_API_KEY=
